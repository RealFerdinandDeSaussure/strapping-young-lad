# -*-bash-ts-*-

setup_sboot() {
    msg "Now, let's set up Secure Boot. Thankfully, you can use this script and do not
have to this ordeal on your own.

We are setting up Secure Boot before enrolling additional secrets for LUKS,
because using the TPM as a secret usually requires binding to the Secure Boot
state (don't woory if you do not know what any of that means)."
}

setup_firewall() {
    msg "Let's install and setup ufw (uncomplicated firwall) with the most basic of
rulesets."

    pacman -Sy ufw || exit 1

    msg "
We will set up ufw to deny ALL incoming traffic and let all outgoing traffic
through. For applications like cloud services, Syncthing, SSH or Torrent
seeders, you will need to adapt the ufw setup later. Oftentimes, this can be
done by simply running \"ufw allow [application]\"."
    pause

    ufw default deny incoming
    msg "Enabling ufw..."
    ufw enable

    setup_sboot
}
