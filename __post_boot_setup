# -*-bash-ts-*-
# shellcheck source=SCRIPTDIR/syl.sh

MS_GUID="77fa9abd-0359-4d32-bd60-28f4e78f784b"

add_to_conf() {
    local conf line header opt
    conf="$1"
    line="${2//\//\\/}"
    header="${3//\//\\/}"
    read -r -d= opt <<< "$line"
    grep -q "^\s*${opt}=" "$conf" && return
    sed -i 's/\(\['"$header"'\]\)/\1\n'"$line"'/' "$conf"
}

get_sb_mode() {
    local mode
    mode="$(LANG=en_US.UTF-8 bootctl | grep 'Secure Boot:' | cut -d: -f2 | xargs)"
    case "$mode" in
        "disabled (setup)")
            shopt -s nullglob
            declare -a PKs
            PKs=(/sys/firmware/efi/efivars/PK*)
            shopt -u nullglob
            if [ ${#PKs[@]} -eq 0 ]; then
                echo -n "setup"
            else
                echo -n "broken"
            fi
            ;;
        "enabled (user)")
            echo -n "on"
            ;;
        *)
            echo -n "off"
            ;;
    esac
}

backup_sb_efivars() {
    local bckp_folder
    bckp_folder="$(get_safe_filename "$HOME/sb-keys.backup-$(date +%s)")"
    mkdir -p "$bckp_folder"

    explain_and_confirm secure_boot
    pacman -Sy --needed efitools sbsigntools systemd-ukify || exit 1

    msg "Backing up Secure Boot efivars..."
    explain_and_confirm backup_efivars "${bckp_folder}"

    for v in PK KEK db dbx; do
        efi-readvar -v $v -o "$bckp_folder/${v}.esl" || exit 1
    done
}

create_sb_key() {
    local guid fn title
    guid="$1"
    fn="$2"
    sign_base="$3"
    title="$4"
    msg "Creating ${title} (${fn})..."

    openssl req -newkey rsa:4096 -noenc -keyout "${fn}.key" -new -x509 -sha256 -days 3650 -subj "/CN=Personal ${title}/" -out "${fn}.crt" || exit 1
    openssl x509 -outform DER -in "${fn}.crt" -out "${fn}.cer" || exit 1
    cert-to-efi-sig-list -g "$guid" "${fn}.crt" "${fn}.esl"  || exit 1
    sign-efi-sig-list -g "$guid" -k "${sign_base}.key" -c "${sign_base}.crt" "${fn}" "${fn}.esl" "${fn}.auth" || exit 1
}

store_sb_keyset() {
    local sb_dir
    sb_dir="$HOME/sb-keys"
    msg "Storing generated keys in ${sb_dir}..."
    mkdir -p "${sb_dir}"
    cp -v "$sb_tmp_dir"/* "${sb_dir}"
    echo "These keys are used for secure boot signing! Do not delete them!" > "${sb_dir}"/DO_NOT_DELETE
}

create_sb_keyset() {
    local cwd guid
    cwd="$(pwd)"
    guid="$(uuidgen --random)"

    cd "$1" || exit 1

    explain_and_confirm create_sb_keyset

    create_sb_key "$guid" "PK" "PK" "Platform Key"
    sign-efi-sig-list -g "$guid" -c PK.crt -k PK.key PK /dev/null noPK.auth || exit 1
    create_sb_key "$guid" "KEK" "PK" "Key Exchange Key"
    create_sb_key "$guid" "db" "KEK" "Signature Database Key"

    cd "$cwd" || exit 1
}

ms_sign() {
    sbsiglist --owner "$MS_GUID" --type x509 --output "$2" "$1" || exit 1
}

download_from_ms() {
    local url fn
    url="$1"
    fn="$(basename "$url")"
    fn="$(printf "%b" "${fn//%/\\x}")"
    curl -Lo "$fn" "$url"
}

create_ms_db() {
    local personal_key_dir cwd
    declare -a urls
    personal_key_dir="$2"
    cwd="$(pwd)"
    urls=("https://www.microsoft.com/pkiops/certs/MicWinProPCA2011_2011-10-19.crt"
          "https://www.microsoft.com/pkiops/certs/windows%20uefi%20ca%202023.crt"
          "https://www.microsoft.com/pkiops/certs/MicCorUEFCA2011_2011-06-27.crt"
          "https://www.microsoft.com/pkiops/certs/microsoft%20uefi%20ca%202023.crt"
          "https://www.microsoft.com/pkiops/certs/MicCorKEKCA2011_2011-06-24.crt"
          "https://www.microsoft.com/pkiops/certs/microsoft%20corporation%20kek%202k%20ca%202023.crt")

    cd "$1" || exit 1

    explain_and_confirm ms_keys
    for u in "${urls[@]}"; do
        msg "Downloading from $u..."
        download_from_ms "$u"
    done
    msg "Creating signature lists..."
    ms_sign "MicWinProPCA2011_2011-10-19.crt" "MS_Win_db_2011.esl"
    ms_sign "windows uefi ca 2023.crt" "MS_Win_db_2023.esl"
    ms_sign "MicCorUEFCA2011_2011-06-27.crt" "MS_UEFI_db_2011.esl"
    ms_sign "microsoft uefi ca 2023.crt" "MS_UEFI_db_2023.esl"
    ms_sign "MicCorKEKCA2011_2011-06-24.crt" "MS_Win_KEK_2011.esl"
    ms_sign "microsoft corporation kek 2k ca 2023.crt" "MS_Win_KEK_2023.esl"
    cat "MS_Win_db_2011.esl" "MS_Win_db_2023.esl" "MS_UEFI_db_2011.esl" "MS_UEFI_db_2023.esl" > MS_db.esl
    cat "MS_Win_KEK_2011.esl" "MS_Win_KEK_2023.esl" > MS_Win_KEK.esl

    sign-efi-sig-list -a -g "$MS_GUID" -k "$personal_key_dir"/KEK.key -c "$personal_key_dir"/KEK.crt db MS_db.esl add_MS_db.auth || exit 1
    sign-efi-sig-list -a -g "$MS_GUID" -k "$personal_key_dir"/PK.key -c "$personal_key_dir"/PK.crt KEK MS_Win_KEK.esl add_MS_Win_KEK.auth || exit 1

    cd "$cwd" || exit 1
}

signing_fail() {
    msg "Enrolling was not succesful. This is often because the firmware has locked
    access to EFI variables. You can sometimes circumvent this be setting or
    resetting the firmware password. After doing so, try running syl.sh 10
    again."

    exit 1
}

enroll_keys() {
    local sb_dir ms_dir sbsign_dir PKs
    declare -a keys
    sb_dir="$1"
    ms_dir="$2"
    sbsign_dir=/etc/secureboot/keys
    shopt -s nullglob

    msg "Copying keys to $sbsign_dir..."
    for i in db dbx KEK PK; do
        keys=({"$sb_dir","$ms_dir"}/*"${i}.auth")
        mkdir -p "${sbsign_dir}/${i}"
        test ${#keys[@]} -eq 0 && continue  # for dbx
        cp -v "${keys[@]}" "${sbsign_dir}/${i}" || exit 1
    done

    explain_and_confirm enroll_keys "${sbsign_dir}"

    for k in /sys/firmware/efi/efivars/{PK,KEK,db}*; do
        chattr -i "$k"
    done
    sbkeysync --keystore "$sbsign_dir" || signing_fail
    msg "Key Exchange Keys and Database enrolled."
    efi-updatevar -f "${sbsign_dir}/PK/PK.auth" PK || signing_fail
    msg "Platform Key enrolled."

    shopt -u nullglob
}

create_pacman_sb_hook() {
    local hook_dir
    hook_dir=/etc/pacman.d/hooks
    mkdir -p "$hook_dir" || exit 1

    # shellcheck disable=2016
    echo '[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/systemd/boot/efi/systemd-boot*.efi

[Action]
Description = Signing systemd-boot for Secure Boot...
When = PostTransaction
Exec = /bin/sh -c '\''while read -r f; do /usr/lib/systemd/systemd-sbsign sign --private-key /root/sb-keys/db.key --certificate /root/sb-keys/db.crt --output "${f}.signed" "$f" >/dev/null ; done;'\''
Depends = sh
NeedsTargets' > "${hook_dir}/80-secureboot.hook"
}

set_sb_signing_in_uki_conf() {
    local conf
    conf=/etc/kernel/uki.conf
    touch "$conf" || exit 1

    grep -qF "[UKI]" "$conf" || echo -e "[UKI]\n" >> "$conf"
    add_to_conf "$conf" "SecureBootCertificate=/root/sb-keys/db.crt" UKI
    add_to_conf "$conf" "SecureBootPrivateKey=/root/sb-keys/db.key" UKI
    add_to_conf "$conf" "SecureBootSigningTool=systemd-sbsign" UKI
    add_to_conf "$conf" "SignKernel=true" UKI
}

sign_bootloader_ukis() {
    explain_and_confirm continuous_signing

    msg "Creating pacman hook..."
    create_pacman_sb_hook
    msg "Adapting uki.conf..."
    set_sb_signing_in_uki_conf

    explain_and_confirm signing_hooks
    pacman -S systemd || exit 1
    bootctl install --no-variables || exit 1
}

setup_sboot() {
    local sb_mode sb_tmp_dir ms_tmp_dir
    sb_tmp_dir="$(mktemp -d)"
    ms_tmp_dir="$(mktemp -d)"
    sb_mode="$(get_sb_mode)"


    case "$sb_mode" in
        "on")
            msg "Secure Boot is already set up. There is nothing to do."
            return
            ;;
        "setup")
            backup_sb_efivars
            ;;
        "broken")
            msg "bootctl reports that we are in setup mode, yet there is a PK EFI variable set.
This should never happen. Check your firmware's Secure Boot implementation."
            exit 1
            ;;
        *)
            backup_sb_efivars
            msg "Secure Boot needs to be in \"Setup Mode\" before we can continue."
            explain setup_mode
            ask_y_n_secure "Do you wish to reboot into firmware now?" && systemctl reboot --firmware-setup
            exit
            ;;
    esac

    create_sb_keyset "$sb_tmp_dir"
    store_sb_keyset

    create_ms_db "$ms_tmp_dir" "$sb_tmp_dir"

    enroll_keys "$sb_tmp_dir" "$ms_tmp_dir"

    explain_and_confirm post_enrollment
    sign_bootloader_ukis

    explain secure_boot_finish
    ask_y_n_secure "Would you like to restart the system now?" && systemctl reboot
    exit
}

setup_firewall() {
    msg "Installing ufw..."
    pacman -Sy --needed ufw || exit 1

    explain_and_confirm ufw

    ufw default deny incoming
    msg "Enabling ufw..."
    ufw enable
}

get_secret_device() {
    local cmd
    declare -a devices
    cmd="$1"
    while read -r line; do
        devices+=("$line")
    done < <(systemd-cryptenroll --"$cmd" list 2>/dev/null | awk '{if ($1 != "PATH") print $1}')

    if [ ${#devices[@]} -eq 0 ]; then
        return
    elif [ ${#devices[@]} -eq 1 ]; then
        echo -n "auto"
        return
    else
        tab_display "${devices[@]}"
        echo -n "$(select_item "${devices[@]}")"
    fi
}

enroll_tpm() {
    local uki_conf part device priv_key pub_key header
    uki_conf=/etc/kernel/uki.conf
    part="$1"
    device="$(get_secret_device tpm2-device)"
    if [ -z "$device" ]; then
        msg "No TPM2 device found. Cannot continue with this secret."
        return
    fi

    explain_and_confirm tpm_pcr
    priv_key=/etc/systemd/tpm2-pcr-private-key.pem
    pub_key=/etc/systemd/tpm2-pcr-public-key.pem

    if [ -f "$priv_key" ] && [ -f "$pub_key" ]; then
        msg "PCR keys already exist. Continuing with existing keys..."
    else
        msg "Generating PCR keys..."
        ukify genkey --pcr-private-key="$priv_key" --pcr-public-key="$pub_key" || exit 1
    fi

    msg "Editing ${uki_conf}..."

    header="PCRSignature:initrd"
    grep -Fq "[${header}]" "$uki_conf" || echo -e "\n[${header}]" >> "$uki_conf"
    add_to_conf "$uki_conf" "PCRPrivateKey=${priv_key}" "$header"
    add_to_conf "$uki_conf" "PCRPublicKey=${pub_key}" "$header"
    add_to_conf "$uki_conf" "Phases=enter-initrd" "$header"

    explain_and_confirm pcr_conf
    edit_file "$uki_conf"

    msg "Rebuilding UKI(s)..."
    mkinitcpio -P || exit 1
    msg "Enrolling TPM2 policy..."
    systemd-cryptenroll --wipe-slot tpm2 --tpm2-device "$device" --tpm2-pcrs="" --tpm2-with-pin=yes "$part" || exit 1
}

enroll_fido2() {
    local part device pin presence verification
    part="$1"
    device="$(get_secret_device "fido2-device")"
    if [ -z "$device" ]; then
        msg "No FIDO2 token found. Cannot continue with this secret."
        return
    fi
    pin=no
    presence=no
    verification=no

    explain fido2_addons
    ask_y_n "Would you like to enter your PIN when using this token?" && pin=yes
    ask_y_n "Would you like to confirm user presence when using this token?" && presence=yes
    ask_y_n "Would you like to use user verification when using this token?" && verification=yes

    msg "Enrolling FIDO2 token..."
    systemd-cryptenroll --fido2-device="${device}" "--fido2-with-client-pin=${pin}" "--fido2-with-user-presence=${presence}" "--fido2-with-user-verification=${verification}" "$part" || exit 1
}

enroll_pkcs11() {
    local part device
    part="$1"
    device=$(get_secret_device "pkcs11-token-uri")
    if [ -z "$device" ]; then
        msg "No PKCS#11 token found. Cannot continue with this secret."
        return
    fi

    msg "Enrolling PKCS#11 token..."
    systemd-cryptenroll --pkcs11-token-uri="$device" "$part"
}

clear_secrets() {
    local part recovery
    declare -a secrets
    part="$1"
    recovery="$(get_safe_filename "$HOME/luks-recovery-key")"

    if ! systemd-cryptenroll "$part" | grep -Fq "recovery"; then
        explain recovery "$recovery"
        if ask_y_n "Would you like to enroll recovery keys?"; then
            systemd-cryptenroll --recovery-key "$part" 2>/dev/null | tee "$recovery" || exit 1
            msg "The recovery key shown above was enrolled and written to ${recovery}."
            msg_bold "Store it safely offline outside of the encrypted partition and delete
${recovery}!"
        fi
    fi

    while read -r line; do
        secrets+=("$line")
    done < <(systemd-cryptenroll "$part" | awk '{if ($1 != "SLOT") print $0}')

    if grep -Fq "password" <<< "${secrets[*]}"&& [ ${#secrets[@]} -gt 1 ]; then
        explain remove_password
        ask_y_n "Would you like to wipe all password slots?" && { systemd-cryptenroll --wipe-slot=password "$part" || exit 1; }
    fi
}

enroll_secrets() {
    local part choice
    part="$1"
    declare -a secrets
    secrets=("PKCS#11" "FIDO2" "none")
    if test_tpm; then
        explain_and_confirm tpm
        secrets=("TPM2" "${secrets[@]}")
    fi

    explain_and_confirm secrets

    while true; do
        msg_bold "Currently enrolled secrets:"
        systemd-cryptenroll "$part"
        msg "Which secret would you like to enroll?"
        tab_display "${secrets[@]}"
        choice="$(select_item "${secrets[@]}")"

        case "$choice" in
            "TPM2")
                enroll_tpm "$part"
                ;;
            "PKCS#11")
                enroll_pkcs11 "$part"
                ;;
            "FIDO2")
                enroll_fido2 "$part"
                ;;
            "none")
                break
                ;;
        esac
    done
    clear_secrets "$part"
}

insert_crypttab_line() {
    local ct options name dev line
    ct=/etc/crypttab.initramfs
    get_config_var ROOT_ENCRYPTED_NAME
    name="${config_vars[ROOT_ENCRYPTED_NAME]}"

    dev=/dev/gpt/auto-root-luks
    if [ ! -b "$dev" ]; then
        get_config_var ROOT_PARTITION
        dev="UUID=$(lsblk -ndo UUID "${config_vars[ROOT_PARTITION]}")"
    fi

    options="$(awk -v n="$name" '{if ($1 == n) print $4}')"
    if [ -z "$options" ]; then
        options="$1"
    else
        options+=",$1"
    fi

    line="$(awk -v n="$name" -v d="$dev" -v o="$options" '{if ($1 == n) print " "n" "d" none "o}' "$ct")"
    if [ -n "$line" ]; then
        sed -i "/^\s*${name}/d" "$ct"
    else
        line=" ${name} ${dev} none ${options}"
    fi

    echo "$line" >> "$ct"
}

set_primary_secret() {
    local part prim key
    declare -a secrets
    part="$1"
    while read -r i; do
        secrets+=("$i")
    done < <(systemd-cryptenroll "$part" | awk '{if ($1 ~ /[[:digit:]]/) print $2}')

    msg "This is the final overview of secrets enrolled for $part:"
    printf "%s\n" "${secrets[@]}"
    if [ ${#secrets[@]} -eq 1 ]; then
        prim="${secrets[0]}"
    else
        msg "Select which of these to use for unlocking at boot."
        prim="$(select_item "${secrets[@]}")"
    fi

    msg "Editing /etc/crypttab.initramfs with ${prim} as primary key..."
    explain_and_confirm crypttab.initramfs "

The \"options\" field is where we specify which of our enrolled hardware tokens
can be used to unlock the root partition. Only one token has been set up added
to the file but you may add additional tokens separated by comma, if you wish.
They can then all be used to unlock the partition at boot. The available options
corresponding to their respective devices are:
    - TPM2: tpm2-device=<device>
    - FIDO2: fido2-device=<device>
    - PKCS#11: pkcs11-token-uri=<uri>
"
    case "$prim" in
        tpm2)
            insert_crypttab_line "tpm2-device=$(get_secret_device tpm2-device)"
            ;;
        fido2)
            insert_crypttab_line "fido2-device=$(get_secret_device fido2-device)"
            ;;
        pkcs11)
            insert_crypttab_line "pkcs11-token-uri=$(get_secret_device "pkcs11-token-uri")"
            ;;
        *)
            :
            ;;
    esac

    edit_file /etc/crypttab.initramfs
}

finalize_luks() {
    local header_bckp
    header_bckp="$(get_safe_filename "$HOME/LUKS_header.bckp")"
    get_config_var ROOT_PARTITION

    enroll_secrets "${config_vars[ROOT_PARTITION]}"

    set_primary_secret "${config_vars[ROOT_PARTITION]}"

    explain luksheader_backup
    if ask_y_n "Would you like to create a backup of the LUKS header?"; then
        cryptsetup luksHeaderBackup "${config_vars[ROOT_PARTITION]}" --header-backup-file "$header_bckp" || exit 1
        msg "Header backup saved at ${header_bckp}."
        msg_bold "Copy it to a safe, offline location outside of the encrypted partition and shred
${header_bckp}!"
    fi
}
