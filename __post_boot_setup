# -*-bash-ts-*-

MS_GUID="77fa9abd-0359-4d32-bd60-28f4e78f784b"

get_sb_mode() {
    local mode
    mode="$(LANG=en_US.UTF-8 bootctl | grep 'Secure Boot:' | cut -d: -f2 | xargs)"
    case "$mode" in
        "disabled (setup)")
            echo -n "setup"
            ;;
        "enabled (user)")
            echo -n "on"
            ;;
        *)
            echo -n "off"
            ;;
    esac
}

backup_sb_efivars() {
    local bckp_folder
    declare -a bckps
    bckp_folder="$HOME/EFIVAR_sb_backup"
    bckps=("$bckp_folder"/*)

    test ${#bckps[@]} -eq 4 && return

    msg "
Before we start, we will backup the current Secure Boot EFI variables to
${bckp_folder}."

    msg "Backing up Secure Boot efivars..."
    mkdir -p /root/EFIVAR_sb_backup
    for v in PK KEK db dbx; do
        efi-readvar -v $v -o "$bckp_folder/${v}.esl" || exit 1
    done
}

create_sb_key() {
    local guid fn title
    guid="$1"
    fn="$2"
    sign_base="$3"
    title="$4"
    msg "Creating ${title} (${fn})..."

    openssl req -newkey rsa:4096 -noenc -keyout "${fn}.key" -new -x509 -sha256 -days 3650 -subj "/CN=Personal ${title}/" -out "${fn}.crt" || exit 1
    openssl x509 -outform DER -in "${fn}.crt" -out "${fn}.cer" || exit 1
    cert-to-efi-sig-list -g "$guid" "${fn}.crt" "${fn}.esl"  || exit 1
    sign-efi-sig-list -g "$guid" -k "${sign_base}.key" -c "${sign_base}.crt" "${fn}" "${fn}.esl" "${fn}.auth" || exit 1
}

create_sb_keyset() {
    local cwd guid
    cwd="$(pwd)"
    guid="$(uuidgen --random)"

    cd "$1" || exit 1

    msg "Now we will create our personal keys. These will be used to sign the EFI
executabes later. Be ready for a lot of screen noise generated by openssl."
    pause

    create_sb_key "$guid" "PK" "PK" "Platform Key"
    sign-efi-sig-list -g "$guid" -c PK.crt -k PK.key PK /dev/null noPK.auth || exit 1
    create_sb_key "$guid" "KEK" "PK" "Key Exchange Key"
    create_sb_key "$guid" "db" "KEK" "Signature Database Key"

    cd "$cwd" || exit 1
}

ms_sign() {
    sbsiglist --owner "$MS_GUID" --type x509 --output "$2" "$1" || exit 1
}

download_from_ms() {
    local url fn
    url="$1"
    fn="$(basename "$url")"
    fn="$(printf "%b" "${fn//%/\\x}")"
    curl -Lo "$fn" "$url"
}

create_ms_db() {
    local personal_key_dir cwd
    declare -a urls
    personal_key_dir="$2"
    cwd="$(pwd)"
    urls=("https://www.microsoft.com/pkiops/certs/MicWinProPCA2011_2011-10-19.crt"
          "https://www.microsoft.com/pkiops/certs/windows%20uefi%20ca%202023.crt"
          "https://www.microsoft.com/pkiops/certs/MicCorUEFCA2011_2011-06-27.crt"
          "https://www.microsoft.com/pkiops/certs/microsoft%20uefi%20ca%202023.crt"
          "https://www.microsoft.com/pkiops/certs/MicCorKEKCA2011_2011-06-24.crt"
          "https://www.microsoft.com/pkiops/certs/microsoft%20corporation%20kek%202k%20ca%202023.crt")

    cd "$1" || exit 1

    msg "Okay, as promised, we will also enroll Microsoft's keys. For this purpose, we
will now create a database update file which we can later apply to our own
database. This requires downloading a couple of certificates from their
website."
    pause
    for u in "${urls[@]}"; do
        download_from_ms "$u"
    done
    msg "Creating signature lists..."
    ms_sign "MicWinProPCA2011_2011-10-19.crt" "MS_Win_db_2011.esl"
    ms_sign "windows uefi ca 2023.crt" "MS_Win_db_2023.esl"
    ms_sign "MicCorUEFCA2011_2011-06-27.crt" "MS_UEFI_db_2011.esl"
    ms_sign "microsoft uefi ca 2023.crt" "MS_UEFI_db_2023.esl"
    ms_sign "MicCorKEKCA2011_2011-06-24.crt" "MS_Win_KEK_2011.esl"
    ms_sign "microsoft corporation kek 2k ca 2023.crt" "MS_Win_KEK_2023.esl"
    cat "MS_Win_db_2011.esl" "MS_Win_db_2023.esl" "MS_UEFI_db_2011.esl" "MS_UEFI_db_2023.esl" > MS_db.esl
    cat "MS_Win_KEK_2011.esl" "MS_Win_KEK_2023.esl" > MS_Win_KEK.esl

    sign-efi-sig-list -a -g "$MS_GUID" -k "$personal_key_dir"/KEK.key -c "$personal_key_dir"/KEK.crt db MS_db.esl add_MS_db.auth || exit 1
    sign-efi-sig-list -a -g "$MS_GUID" -k "$personal_key_dir"/PK.key -c "$personal_key_dir"/PK.crt KEK MS_Win_KEK.esl add_MS_Win_KEK.esl || exit 1

    cd "$cwd" || exit 1
}

enroll_keys() {
    sb_dir="$1"
    ms_dir="$2"
    sbsign_dir=/etc/secureboot/keys

    msg "Copying keys to $sbsign_dir..."
    shopt -s nullglob
    for i in db dbx KEK PK; do
        mkdir -p "${sbsign_dir}/${i}"
        cp "${sb_dir}"/*"${i}.auth" "${ms_dir}"/*"${i}.auth" "${sbsign_dir}/${i}" || exit 1
    done
    shopt -u nullglob

    msg "All keys are now located at ${sbsign_dir}. We will now use sbkeysync to enroll them."
    pause
    sbkeysync --keystore "$sbsign_dir" --verbose || exit 1
    sbkeysync --keystore "$sbsign_dir" --verbose --pk || exit 1
}

create_pacman_sb_hook() {
    local hook_dir
    hook_dir=/etc/pacman.d/hooks
    mkdir -p "$hook_dir" || exit 1

    echo '[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/systemd/boot/efi/systemd-boot*.efi

[Action]
Description = Signing systemd-boot EFI binary for Secure Boot
When = PostTransaction
Exec = /bin/sh -c '\''while read -r f; do /usr/bin/sbsign --key /etc/secureboot/keys/db/db.key --cert /etc/secureboot/keys/db/db.crt --output "${f}.signed" "$f"; done;'\''
Depends = sh
NeedsTargets' > "${hook_dir}/80-secureboot.hook"
}

create_mkinitcpio_sb_hook() {
    local hook_dir
    hook_dir=/etc/initcpio/post
    mkdir -p "$hook_dir" || exit 1

    echo '#!/usr/bin/env bash

uki="$3"
[[ -n "$uki" ]] || exit 0

keypairs=(/etc/secureboot/keys/db/db.key /etc/secureboot/keys/db/db.crt)

for (( i=0; i<${#keypairs[@]}; i+=2 )); do
    key="${keypairs[$i]}" cert="${keypairs[(( i + 1 ))]}"
    if ! sbverify --cert "$cert" "$uki" &>/dev/null; then
        sbsign --key "$key" --cert "$cert" --output "$uki" "$uki"
    fi
done' > "${hook_dir}/uki-sbsign"
}

sign_bootloader_ukis() {
    msg "Neither the bootloader nor the UKIs will remain unchanged with time. Updates to
either systemd-boot or the kernel will trigger either a new EFI binary being
copied to the EFI system partition or a rebuild of the associated UKI. Every
time this happens, the respective files need to be resigned. To make this
possible, we are using a mkinitcpio hook (for the UKI) and a pacman hook (for
systemd-boot).

To make sure that both the pacman and mkinitcpio hook are working, we will not
sign anything manually but create the hooks and use them to trigger the signing
process."

    msg "
Creating pacman hook..."
    create_pacman_sb_hook
    msg "To trigger the hook, we will run \"pacman -S systemd\" and
\"bootctl update\". The first command will trigger the hook, the second will
copy the updated (signed) bootloader EFI binary to the EFI system partition."
    pause
    pacman -S systemd || exit 1
    bootctl update || exit 1

    msg "
Creating mkinitcpio hook..."
    create_mkinitcpio_sb_hook
    msg "To trigger the hook, we will rebuild the UKI. The hook will run after the build
process has finished and sign the generated UKI."
    pause
    mkinitcpio -P || exit 1
}

setup_sboot() {
    local sb_mode sb_dir ms_dir
    sb_dir="$(mktemp -d)"
    ms_dir="$(mktemp -d)"
    sb_mode="$(get_sb_mode)"

    if [ "$sb_mode" = "on" ]; then
        msg "Secure Boot is already set up. There is nothing to do."
        pause "Press any key to continue with the next step."
        return
    fi

    msg "Okay then, let's set up Secure Boot. Thankfully, you can use this script and do not
have to go through this ordeal on your own.

We are setting up Secure Boot before enrolling additional secrets for LUKS,
because using the TPM as a secret often requires binding to the Secure Boot
state (don't worry if you do not know what any of that means).

Before, we start let's install a couple of packages that we will need in the
process."
    pause

    pacman -Sy --needed efitools sbsigntools || exit 1

    backup_sb_efivars

    if [ "$(get_sb_mode)" != setup ]; then
        msg "Secure Boot needs to be in \"Setup Mode\" before we can continue. To enter setup
mode, you need to enter your motherboard's firmware (sometimes called BIOS) and
delete the Platform Keys. Look for options allowing you to delete certificates
or delete PK. After rebooting run ./syl.sh 10 to continue at the current step.

\"systemctl reboot --firmware-setup\" can be used to boot into firmware."
        ask_y_n_secure "Do you wish to run this command now?" && systemctl reboot --firmware-setup
        exit
    fi

    create_sb_keyset "$sb_dir"
    create_ms_db "$ms_dir" "$sb_dir"

    msg "
Okay, now that that is all done, let's finally enroll our and Microsoft's keys."
    enroll_keys "$sb_dir" "$ms_dir"

    msg "The keys have been enrolled. At this point, all EFI binaries signed with
Microsoft's keys should be bootable. The firmware will also enable Secure Boot
user mode on the next reboot. Without signing the kernel and the bootloader, the
system will fail to boot. So let's do that next."
    sign_bootloader_ukis

    msg "
That concludes the Secure Boot setup. You should now reboot the system and run
this step again by executing ./syl.sh 10. If everything went as expected, the
script will let you know that Secure Boot is already active after you agree to
continue with the step."
    ask_y_n "Would you like to restart the system now?" && systemctl reboot
    exit
}

setup_firewall() {
    msg "Let's install and setup ufw (uncomplicated firwall) with the most basic of
rulesets."

    pacman -Sy --needed ufw || exit 1

    msg "
We will set up ufw to deny ALL incoming traffic and let all outgoing traffic
through. For applications like cloud services, Syncthing, SSH or Torrent
seeders, you will need to adapt the ufw setup later. Oftentimes, this can be
done by simply running \"ufw allow [application]\"."
    pause

    ufw default deny incoming
    msg "Enabling ufw..."
    ufw enable
}
