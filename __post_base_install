# -*-bash-ts-*-
# shellcheck source=SCRIPTDIR/syl.sh

setup_sutool() {
    local choice conf
    declare -a sutools verifyer
    sutools=("sudo" "doas" "sudo-rs")

    msg "Which of the aforementioned tools would you like to install?"
    tab_display "${sutools[@]}"
    choice="$(select_item "${sutools[@]}")"

    if ! pacman -Q "$choice" >/dev/null 2>&1; then
        msg "Installing ${choice}..."
        prexec pacman -Sy "$choice" || exit 1
    fi

    case "$choice" in
        sudo)
            setup_sudo
            conf=/etc/sudoers
            verifyer=("visudo" "-c")
            ;;
        doas)
            setup_doas
            conf=/etc/doas.conf
            verifyer=("doas" "-C" "$conf")
            ;;
        "sudo-rs")
            setup_sudo rs
            conf=/etc/sudoers-rs
            verifyer=("visudo-rs" "-c")
            ;;
    esac

    msg "Setting secure permissions for ${conf}..."
    prexec chown -c root:root "$conf" || exit 1
    prexec chmod -c 0440 "$conf" || exit 1
    if ! "${verifyer[@]}" >/dev/null; then
        msg_bold "The configuration at ${conf} was not verified succesfully!"
        msg "${choice} will *not* work correctly. Please check the configuration file
manually before proceeding. To verify it again, run the following command:"
        msg "${verifyer[@]}"
        msg_bold " Do not proceed before the configuration file verifies succesfully!"
        exit 1
    fi
}

setup_sudo() {
    local rs sudoers rules
    declare -a opts
    rs="$1"
    if [ "$rs" = "rs" ]; then
        sudoers=/etc/sudoers-rs
        setup_sudo_rs
    else
        sudoers=/etc/sudoers
    fi

    touch "$sudoers"

    ask_y_n "Would you like to allow users belonging to the group wheel to execute commands
with super-user privileges?" && opts+=("%wheel ALL=(ALL:ALL) ALL")
    msg "By default the sudo prompt will timeout after 5 minutes."
    ask_y_n "Would you like to disable this timeout?" && opts+=("Defaults passwd_timeout=0")

    for o in "${opts[@]}"; do
        ! grep -q "^\s*${o}\s*$" "$sudoers" && rules+=$'\n'
    done
}

setup_sudo_rs() {
    if pacman -Q sudo >/dev/null 2>&1; then
        msg "sudo is already installed on your system so its configuration file for Linux's
pam framework is already in place and we do not need to create it here."
        msg_bold "Please be aware that this means sudo-rs will stop working, should you decide to
uninstall sudo at a later time."
    else
        msg "Writing authentication configuration file for PAM..."
        echo "#%PAM-1.0
auth		include		system-auth
account		include		system-auth
session		include		system-auth" > /etc/pam.d/sudo
    fi
    msg "Creating symlinks to sudo for sudo-rs..."
    prexec ln -vbs --suffix=.bckp /usr/bin/sudo-rs /usr/local/bin/sudo || exit 1
    prexec ln -vbs --suffix=.bckp /etc/pam.d/sudo /etc/pam.d/sudo-i || exit 1
}

setup_doas() {
    local conf
    declare -a opts
    conf=/etc/doas.conf

    touch "$conf"

    ask_y_n "Would you like to allow users belonging to the group wheel to execute commands
with super-user privileges?" && opts+=('permit setenv {PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin} :wheel')
    msg "By default doas does not cache credentials. However, it does provide the option
to store credentials for 5 minutes. During this time you will not be prompted
for your password again."
    ask_y_n "Would you like to set this option for the wheel group?" && opts+=('permit persist setenv {PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin} :wheel')

    for o in "${opts[@]}"; do
        ! grep -q "^\s*${o}\s*$" "$conf" && echo "${o}" >> "$conf"
    done
}

add_u() {
    local name shell groups
    declare -a group_arr
    read -rp "  Please provide a user name for the new account: " name

    msg "Please provide the full path to the login shell below. An incorrect path will
result in the user being unable to login."
    while true; do
        read -rp "  What is the user's login shell (default: /bin/bash): " shell
        test -z "$shell" && shell=/bin/bash
        test -f "$shell" && break
        msg "$shell does not exist."
    done

    explain groups
    while true; do
        read -rp "  What groups should the user be added to (default: none)? " groups
        IFS=" " read -ra group_arr <<< "$groups"
        for g in "${group_arr[@]}"; do
            cut -d: -f1 < /etc/group | grep -Fxq "$g" && continue
            msg "Group $g does not exist."
            continue 2
        done
        break
    done

    msg "Creating user $name..."
    prexec useradd -m -G "$groups" -s "$shell" "$name" || exit 1
    if [[ "$groups" =~ "wheel" ]]; then
        msg "Please provide a password for ${name}."
        prexec passwd "$name" || exit 1
    else
        msg "It is recommended to specify a password for each user."
        ask_y_n "Would you like to set a password for ${name}?" && { passwd "$name" || exit 1; }
    fi
}

add_users() {
    while true; do
        ask_y_n "Do you wish to add additional users?" || break
        add_u
    done
}

setup_pipewire() {
    local answer
    declare -a pkgs users choice
    pkgs=("pipewire" "pipewire-alsa" "pipewire-pulse")
    msg "Installing PipeWire and related packages..."
    ask_y_n "Would you like to also install the PipeWire documentation package?" && pkgs+=("pipewire-docs")
    prexec pacman -Sy --needed "${pkgs[@]}" || exit 1

    while read -r line; do
        users+=("$line")
    done < <(userdbctl -R --output=classic | cut -d: -f1)
    test ${#users[@]} -eq 0 && return

    msg "PipeWire can be enabled on a per-user basis. Please give a list of users
(separated by spaces) for whom you would like to enable PipeWire."
    while true; do
        tab_display "${users[@]}"
        read -rp "  For which users should PipeWire be enabled? " answer
        read -ra choice <<< "$answer"
        for u in "${choice[@]}"; do
            test -d /home/"$u" && continue
            msg "User $u does not exist."
            continue 2
        done
        break
    done

    for u in "${choice[@]}"; do
        prexec machinectl shell "${u}@" /usr/bin/systemctl --user enable pipewire.socket || exit 1
    done
}

setup_auto_login() {
    local choice dropin
    dropin=/etc/systemd/system/getty@tty1.service.d/autologin.conf
    declare -a users

    while read -r line; do
        users+=("$line")
    done < <(userdbctl -R --output=classic | cut -d: -f1)
    test ${#users[@]} -eq 0 && return

    if [ ${#users[@]} -eq 1 ]; then
        choice="${users[0]}"
    else
        msg "Please select the user that will log in automatically at boot."
        tab_display "${users[@]}"
        choice="$(select_item "${users[@]}")"
    fi

    msg "Editing ${dropin}..."
    mkdir -p "$(dirname "$dropin")"

    explain getty-dropin "$dropin" "$choice"
    echo "[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --skip-login --nonewline --noissue --autologin ${choice} --noreset --noclear - \${TERM}" > "$dropin"
    edit_file "$dropin"
    msg "The edits in the drop-in file will be picked up at the next boot."
}

finish_setup() {
    explain pacman_color
    ask_y_n "Would you like to enable pacman color output?" && { sed -i 's/^#Color/Color/' /etc/pacman.conf || exit 1; }

    explain sudo
    ask_y_n "Would you like to set up or one of its alternatives?" && setup_sutool

    explain users
    add_users

    explain sound_server
    ask_y_n "Would you like to set up PipeWire as an audio server?" && setup_pipewire

    msg "If you have set up an encryption password, you may not want to enter another
password for logging in. To avoid this, you can enable automatic login on the
virtual console of tty1 (or any other tty but we will only deal with tty1)."
    ask_y_n "Would you like to setup auto-login on tty1?" && setup_auto_login

    explain goodbye
}
