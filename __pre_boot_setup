# -*-bash-ts-*-
# shellcheck source=SCRIPTDIR/syl.sh

 achroot() {
    arch-chroot /mnt "$@"
}

set_time() {
    local region city
    declare -a items

    for i in /mnt/usr/share/zoneinfo/[A-Z]*; do
        test -d "$i" && items+=("$(basename "$i")")
    done
    msg "First, select a region:"
    tab_display "${items[@]}"
    region=$(select_item "${items[@]}")

    items=()
    for i in /mnt/usr/share/zoneinfo/"$region"/[A-Z]*; do
        test -f "$i" && items+=("$(basename "$i")")
    done
    msg "Now, select a city:"
    tab_display "${items[@]}"
    city=$(select_item "${items[@]}")

    msg "Setting $region/$city as local time..."
    achroot ln -sf "/usr/share/zoneinfo/$region/$city" /etc/localtime || exit 1

    msg "Setting up /etc/adjtime so the system will not modify the hardware clock..."
    achroot hwclock --systohc || exit 1

    msg "Activating systemd-timesyncd with default config for continuous time synchronization..."
    achroot systemctl enable systemd-timesyncd.service || exit 1
}

set_locales() {
    local system_locale
    declare -a items locales

    sed -ri 's/^#(en_US.UTF-8 UTF-8)/\1/' /mnt/etc/locale.gen
    msg "Choose any locale you wish to include on your system. 'en_US UTF-8' is always included.
Only UTF-8 locales are supported by this script."

    while read -r line; do
        [[ ! "$line" =~ "UTF-8" ]] && continue
        items+=("$(echo "$line" | cut -d" " -f1)")
    done < <(sed -rn 's/^#(\S+\s\S+)/\1/p' /mnt/etc/locale.gen)
    while true; do
        if ask_y_n "Do you wish to add more locales?"; then
            tab_display "${items[@]}"
            locales+=("$(select_item "${items[@]}") UTF-8")
        else
            break
        fi
    done
    for l in "${locales[@]}"; do
        sed -ri 's/^#('"$l"')/\1/' /mnt/etc/locale.gen
    done
    achroot locale-gen || exit 1

    items=()
    msg "Choose the system locale among the ones you previously selected."
    while read -r line; do
        items+=("$line")
    done < <(sed -rn 's/^([^#]\S+).+/\1/p' /mnt/etc/locale.gen)
    tab_display "${items[@]}"
    system_locale="$(select_item "${items[@]}")"
    achroot localectl set-locale LANG="$system_locale" || exit 1
}

set_hostname() {
    local hostname
    while true; do
        read -rp "  Please type in a hostname: " hostname
        test -z "$hostname" && continue
        hostname="$(echo -n "$hostname" | tr -dc '[:alnum:]' | tr '[:upper:]' '[:lower:]')"
        hostname="${hostname/#-/}"
        hostname="${hostname:0:63}"
        msg "Adapted to adhere to RFC 1178, this is your hostname: $hostname"
        ask_y_n "Would you like to continue with this name?" && break
    done
    echo "$hostname" > /mnt/etc/hostname || exit 1
}

set_vcons_kl() {
    declare -a layouts
    while read -r line; do
        layouts+=("$line")
    done < <(localectl list-keymaps)

    tab_display "${layouts[@]}"
    echo "KEYMAP=$(select_item "${layouts[@]}" | xargs)" > /mnt/etc/vconsole.conf || exit 1
}

create_netservice() {
    local base service custom
    declare -a ex
    base="$1"
    custom="$2"

    msg "Creating link to $base service file..."
    ex=(/mnt/usr/lib/systemd/network/*-"$base".network.example)
    service="$(basename "${ex[0]/%.example/}")"
    achroot ln -vfs "${ex[0]/#\/mnt/}" /etc/systemd/network/"$service" >&2 || exit 1
    echo "[Link]
Multicast=yes
RequiredForOnline=routable

[Network]
MulticastDNS=yes" > "$custom"
    echo -n "$service"
}

create_net_dropin() {
    local dropin_folder
    dropin_folder=/mnt/etc/systemd/network/"$1".d
    mkdir -p "$dropin_folder"
    # sytemd-networkd requires these files to have 644 umask
    install -m 644 "$2" "$dropin_folder"/10-custom.conf
}

setup_network() {
    local eth_serv wifi_serv eth_custom wifi_custom
    declare -a ex
    eth_custom="$(mktemp)"
    wifi_custom="$(mktemp)"

    ask_y_n "Would you like to configure wired network access?" && eth_serv="$(create_netservice ethernet "$eth_custom")"
    if achroot pacman -Q iwd >/dev/null 2>&1; then
        wifi_serv="$(create_netservice wifi-station "$wifi_custom")"
        echo "IgnoreCarrierLoss=3s" >> "$wifi_custom"
    fi

    test -z "$eth_serv$wifi_serv" && return

    if [ -n "$eth_serv" ] && [ -n "$wifi_serv" ]; then
        for c in "$eth_custom" "$wifi_custom"; do
            echo -e "\n[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100 " >> "$c"
        done
    fi

    if [ -n "$eth_serv" ] && [ -n "$wifi_serv" ]; then
        explain drop_in "
    - creating a smoother transition from wifi to ethernet connections"
    else
        explain drop_in
    fi

    if ask_y_n "Would you like to extend the configuration presets?"; then
        msg "Creating custom drop-in file(s)..."
        test -n "$eth_serv" && create_net_dropin "$eth_serv" "$eth_custom"
        test -n "$wifi_serv" && create_net_dropin "$wifi_serv" "$wifi_custom"
    fi

    if achroot pacman -Q dnscrypt-proxy >/dev/null 2>&1; then
        msg "Setting up dnscrypt-proxy for local DNS resolving..."
        sed -ri 's/^listen_addresses.+$/listen_addresses = ['\''127.0.0.1:53'\'', '\''[::1]:53'\'']/' /mnt/etc/dnscrypt-proxy/dnscrypt-proxy.toml
        echo "nameserver ::1
nameserver 127.0.0.1
options edns0" >> /mnt/etc/resolv.conf
        achroot systemctl enable dnscrypt-proxy.service || exit 1
    fi

    msg "Enabling systemd network services..."
    achroot systemctl enable systemd-networkd.service || exit 1
    if [ -n "$wifi_serv" ]; then
        achroot systemctl enable iwd.service || exit 1
    fi
}

calculate_swap_rec_zram() {
    local ram_mb
    ram_mb="$(awk_calc "$1 / 1024")"
    if ((0<=ram_mb && ram_mb<=2048)); then
        echo -n 3
    elif ((2049<=ram_mb && ram_mb<=4096)); then
        echo -n 2
    elif ((4097<=ram_mb && ram_mb<=16384)); then
        echo -n 1
    else
        echo -n 0
    fi
}

calculate_swap_rec_no_zram() {
    local ram_mb swap_mb
    ram_mb="$(awk_calc "$1 / 1024")"

    if ((0<=ram_mb && ram_mb<=2048)); then
        swap_mb=$((ram_mb * 2))
    elif ((2049<=ram_mb && ram_mb<=4096)); then
        swap_mb=$(awk_calc "ram_mb * 1.5")
    elif ((4097<=ram_mb && ram_mb<=8192)); then
        swap_mb=$ram_mb
    elif ((8193<=ram_mb && ram_mb<=16384)); then
        swap_mb=$(awk_calc "ram_mb / 2")
    elif ((16385<=ram_mb && ram_mb<=32768)); then
        swap_mb=8192
    else
        swap_mb=4096
    fi
    awk_calc "$swap_mb / 1024"
}

create_swap() {
    local swapfile
    swapfile=/mnt/swap/swapfile
    msg "Creating swap file..."
    if ! test -f "$swapfile"; then
        mkswap -U clear --size "$1" --file "$swapfile" || exit 1
    fi

    msg "Mounting swap file..."
    swapon "$swapfile" || exit 1
}

create_zram() {
    local zram_conf zram_dev
    zram_conf=/mnt/etc/systemd/zram-generator.conf

    msg "Generating zram-generator config file..."
    echo "[zram0]
zram-size = min(ram / 2, 4096)
compression-algorithm = zstd" > "$zram_conf"
    explain_and_confirm zram-generator.conf
    edit_file "$zram_conf"

    # in case the user has added additional zram devices
    while read -r line; do
        zram_dev="${line:1:-1}"
        msg "Enabling systemd service for ${zram_dev}..."
        achroot systemctl enable systemd-zram-setup@"$zram_dev".service
    done < <(grep -E '^\[.+?\]$' "$zram_conf")
}

create_swap_zram() {
    # TODO: use zswap when using hibernation
    local hib zram ram_kb ram_gb rec
    ram_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
    ram_gb="$(awk_calc "$ram_kb / 1024 / 1024")"
    ask_y_n "Will you use hibernation on the system?" && hib=yes
    achroot pacman -Q zram-generator >/dev/null 2>&1 && zram=yes

    if [ -n "$zram" ]; then
        rec="$(calculate_swap_rec_zram "$ram_kb")"
    else
        rec="$(calculate_swap_rec_no_zram "$ram_kb")"
    fi

    if [ -n "$hib" ] && [ "$rec" -lt $(("$ram_gb" + 2)) ]; then
        rec=$(("$ram_gb" + 2))
    fi


    msg -e "Your system has \033[1m${ram_gb}GB\033[0m of RAM."
    msg -n "The recommended swap size is: "
    if [ "$rec" = 0 ]; then
        msg "None."
        msg "Your system should run fine depending only on RAM and zram."
    else
        rec+="G"
        msg_bold "${rec}B"
    fi

    if ! ask_y_n "Would you like to continue with the recommendation?"; then
        read -rp "  Please give a swap size parseable by mkswap (e.g. ending in M or G): " rec
    fi

    test "$rec" = 0 && return

    create_swap "$rec"
    test -n "$zram" && create_zram
}

prepare_system() {
    test_system_mounted || exit 1

    echo "First, let's setup swap and zram."
    explain swap_zram
    ask_y_n "Would you like to continue?" continue skip && create_swap_zram

    echo "With all partitions mounted and a swap file created, we can generate the file
system table."
    if ask_y_n "Would you like to continue?" continue skip; then
        genfstab -U /mnt >> /mnt/etc/fstab || exit 1
        msg "The fstab file was successfully created. However, it is recommended to check it
manually for errors.
For this, we will open it using \$EDITOR."
        pause
        edit_file /mnt/etc/fstab
    fi

    msg "On to time settings. Please note that your system's hardware clock needs to be
set to UTC for this to work correctly."
    ask_y_n "Would you like to continue?" continue skip && set_time

    msg "Now, locale settings."
    ask_y_n "Would you like to continue?" continue skip && set_locales

    msg "If you are using a keyboard layout other than the default US one, you can set
it as default for the virtual console. This will most likely not affect the
keyboard settings in a desktop environment."
    ask_y_n "Would you like to specify a custom keyboard layout?" && set_vcons_kl

    msg "Select a hostname next. In line with RFC 1178, a hostname should only include
lowercase letters, digits and dashes (but not at the beginning)."
    ask_y_n "Would you like to continue?" continue skip && set_hostname

    msg "For network access on the new system, we will use systemd-networkd for wired and
iwd for wireless access."
    ask_y_n "Would you like to continue?" continue skip && setup_network

    msg "Finally, we will run passwd on the new system to set its root password."
    ask_y_n "Would you like to continue?" continue skip && achroot passwd
}

add_hook() {
    local hook_line hook before
    hook_line="$1"
    hook="$2"
    before="$3"
    grep -q "$hook" <<< "$hook_line" || hook_line="${hook_line/"$before"/"$hook" "$before"}"
    echo -n "$hook_line"
}

remove_hook() {
    local hook_line hook
    hook_line="$1"
    hook="$2"
    grep -q "$hook" <<< "$hook_line" && hook_line="${hook_line/"$hook" /}"
    echo -n "$hook_line"
}

adapt_hooks() {
    local hooks sdv_hook
    hooks="$(grep '^HOOKS' "$1")"

    ask_y_n "Will you be using a non-standard keymap or console font?" && sdv_hook="sd-vconsole"

    if achroot pacman -Qqs -- '-ucode$' >/dev/null 2>&1; then
        hooks="$(add_hook "$hooks" microcode modconf)"
    fi

    # remove udev as it is supplanted by systemd hook
    hooks="$(remove_hook "$hooks" udev)"
    hooks="$(add_hook "$hooks" systemd autodetect)"
    hooks="$(add_hook "$hooks" keyboard block)"
    # remove keymap and consolefont as they are also supplanted by systemd
    hooks="$(remove_hook "$hooks" keymap)"
    hooks="$(remove_hook "$hooks" consolefont)"
    test -n "$sdv_hook" && hooks="$(add_hook "$hooks" "$sdv_hook" block)"
    hooks="$(add_hook "$hooks" sd-encrypt filesystems)"

    sed -i 's/^HOOKS=.*/'"$hooks"'/' "$1" || exit 1
}

generate_kcmdline() {
    local efi root cmdline
    get_config_var EFI_PARTITION
    efi="${config_vars[EFI_PARTITION]}"
    get_config_var ROOT_PARTITION
    root="${config_vars[ROOT_PARTITION]}"
    get_config_var ROOT_ENCRYPTED_NAME
    cryptroot="${config_vars[ROOT_ENCRYPTED_NAME]}"

    explain kernel_cmdline

    if [ "$(get_p_parent "$efi")" = "$(get_p_parent "$root")" ]; then
        explain gpt_automounting
        if ask_y_n "Would you like to use GPT automounting?"; then
            config_vars[GPT_AUTOMOUNT]=1
        else
            config_vars[GPT_AUTOMOUNT]=0
        fi
    fi
    
    msg "Editing kernel commandline file..."
    if [ "${config_vars[GPT_AUTOMOUNT]}" = 0 ]; then
        explain_and_confirm kernel_cmdline_options " || pause
    - root: the root partition (i.e. the mapping of the unlocked cryptdevice)"
    else
        explain_and_confirm kernel_cmdline_options || pause
    fi

    cmdline="rootflags=subvol=@ quiet bgrt_disable"
    test "${config_vars[GPT_AUTOMOUNT]}" = 0 && cmdline="root=/dev/mapper/$cryptroot $cmdline"
    echo "$cmdline" > /mnt/etc/kernel/cmdline
    edit_file /mnt/etc/kernel/cmdline
}

create_crypttab_initramfs() {
    local root root_entry
    get_config_var ROOT_PARTITION
    root="${config_vars[ROOT_PARTITION]}"
    get_config_var GPT_AUTOMOUNT


    if [ "${config_vars[GPT_AUTOMOUNT]}" = 1 ]; then
        explain crypttab.initramfs "

As you have set up automounting, you do not need to create this file. After setting up hardware tokens to unlock the encrypted root volume, we will come back to crypttab.initramfs as it is needed to specify the unlock method at boot. If you would like, we can still create an crypttab.initramfs file now."
    ask_y_n "Would you like to create and edit crypttab.initramfs now?" || return
    else
        msg "Editing crypttab.initramfs..."
        explain_and_confirm crypttab.initramfs || pause
    fi

    if [ "${config_vars[GPT_AUTOMOUNT]}" = 1 ]; then
        root_entry="  cryptroot    /dev/gpt-auto-root-luks    none"
    else
        root_entry="  cryptroot    UUID=$(lsblk -ndo UUID "$root")    none"
    fi

    echo "$root_entry" >> /mnt/etc/crypttab.initramfs
    edit_file /mnt/etc/crypttab.initramfs
    # option for crypttab.initramfs (fido2)
}

setup_mkinitcpio() {
    local BINARIES mkcp_conf hooks uki_folder
    mkcp_conf="$(mktemp)"
    
    msg "Editing mkinitcpio.conf..."
    explain_and_confirm mkinitcpio.conf || pause
    cp /mnt/etc/mkinitcpio.conf "$mkcp_conf"

    source <(grep "^BINARIES" "$mkcp_conf")
    if [[ ! "${BINARIES[*]}" =~ "btrfs" ]]; then
        BINARIES+=("btrfs")
        sed -i 's/^BINARIES=.*/BINARIES=('"${BINARIES[*]}"')/' "$mkcp_conf" || exit 1
    fi

    adapt_hooks "$mkcp_conf"

    pause
    edit_file "$mkcp_conf"
    cp "$mkcp_conf" /mnt/etc/mkinitcpio.conf

    explain mkinitcpio_presets

    for p in /mnt/etc/mkinitcpio.d/*.preset; do
        msg "Editing $p..."
        pause
        for i in default_uki fallback_uki default_options; do
            sed -ri 's/^#('"${i}"'=)/\1/' "$p" || exit 1
            sed -ri 's/("\/)efi/\1boot/' "$p" || exit 1
        done
        edit_file "$p"
    done

    generate_kcmdline

    create_crypttab_initramfs

    msg "Now let's create our unified kernel image(s)."
    for p in /mnt/etc/mkinitcpio.d/*.preset; do
        uki_folder="$(grep '^default_uki=' "$p" | cut -d= -f2 | tr -d '"')"
        if [ -z "$uki_folder" ]; then
            msg "Error! No definition for \"default_uki\" found in $p."
            exit 1
        fi
        mkdir -p "/mnt/$(dirname "$uki_folder")" || exit 1
        achroot mkinitcpio -p "$(basename -s ".preset" "$p")"
    done
}

install_bootloader() {
    local default loader_conf
    loader_conf=/mnt/boot/loader/loader.conf

    msg "Running \"bootctl install\"..."
    achroot bootctl install || exit 1
    msg "Enabling automatic bootloader updates..."
    achroot systemctl enable systemd-boot-update.service || exit 1

    msg "Editing bootloader config..."

    for e in /mnt/boot/EFI/Linux/*.efi; do
        echo -n "$e" | grep -q "fallback" && continue
        default="$(basename "$e")" && break
    done

    echo "default */$default
timeout menu-hidden
editor false
console-mode max" > "$loader_conf"

    explain_and_confirm bootloader_conf || pause
    edit_file "$loader_conf"
}

make_bootable() {
    test_system_mounted || exit 1

    explain_and_confirm create_ukis

    setup_mkinitcpio

    msg "Now, let's install the bootloader."
    install_bootloader
}
