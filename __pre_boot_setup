# -*-bash-ts-*-
 achroot() {
    arch-chroot /mnt "$@"
}

set_time() {
    local region city
    declare -a items

    for i in /mnt/usr/share/zoneinfo/[A-Z]*; do
        test -d "$i" && items+=("$(basename "$i")")
    done
    msg "First, select a region:"
    region=$(select_item "${items[@]}")

    items=()
    for i in /mnt/usr/share/zoneinfo/"$region"/[A-Z]*; do
        test -f "$i" && items+=("$(basename "$i")")
    done
    msg "
Now, select a city:"
    city=$(select_item "${items[@]}")

    msg "Setting $region/$city as local time..."
    achroot ln -sf "/usr/share/zoneinfo/$region/$city" /etc/localtime || exit 1

    msg "Setting up /etc/adjtime so the system will not modify the hardware clock..."
    achroot hwclock --systohc || exit 1

    msg "Activating systemd-timesyncd with default config for continuous time synchronization..."
    achroot systemctl enable systemd-timesyncd.service || exit 1
}

set_locales() {
    local system_locale
    declare -a items locales

    sed -ri 's/^#(en_US.UTF-8 UTF-8)/\1/' /mnt/etc/locale.gen
    msg "Choose any locale you wish to include on your system. 'en_US UTF-8' is always included.
Only UTF-8 locales are supported by this script."

    while read -r line; do
        [[ ! "$line" =~ "UTF-8" ]] && continue
        items+=("$(echo "$line" | cut -d" " -f1)")
    done < <(sed -rn 's/^#(\S+\s\S+)/\1/p' /mnt/etc/locale.gen)
    while true; do
        if ask_y_n "Do you wish to add more locales?"; then
            locales+=("$(select_item "${items[@]}") UTF-8")
        else
            break
        fi
    done
    for l in "${locales[@]}"; do
        sed -ri 's/^#('"$l"')/\1/' /mnt/etc/locale.gen
    done
    achroot locale-gen || exit 1

    items=()
    msg "
Choose the system locale among the ones you previously selected."
    while read -r line; do
        items+=("$line")
    done < <(sed -rn 's/^([^#]\S+).+/\1/p' /mnt/etc/locale.gen)
    system_locale="$(select_item "${items[@]}")"
    achroot localectl set-locale LANG="$system_locale" || exit 1
}

set_hostname() {
    local hostname
    while true; do
        read -rp "  Please type in a hostname: " hostname
        test -z "$hostname" && continue
        hostname="$(echo -n "$hostname" | tr -dc '[:alnum:]' | tr '[:upper:]' '[:lower:]')"
        hostname="${hostname/#-/}"
        hostname="${hostname:0:63}"
        msg "Adapted to adhere to RFC 1178, this is your hostname: $hostname"
        ask_y_n "Would you like to continue with this name?" && break
    done
    echo "$hostname" > /mnt/etc/hostname || exit 1
}

set_vcons_kl() {
    declare -a layouts
    while read -r line; do
        layouts+=("$line")
    done < <(localectl list-keymaps)

    echo "KEYMAP=$(select_item "${layouts[@]}" | xargs)" > /mnt/etc/vconsole.conf || exit 1
}

create_netservice() {
    local base service custom
    declare -a ex
    base="$1"
    custom="$2"

    msg "Creating link to $base service file..."
    ex=(/mnt/usr/lib/systemd/network/*-"$base".network.example)
    service="$(basename "${ex[0]/%.example/}")"
    achroot ln -vfs "${ex[0]/#\/mnt/}" /etc/systemd/network/"$service" >&2 || exit 1
    echo "[Link]
Multicast=yes
RequiredForOnline=routable

[Network]
MulticastDNS=yes" > "$custom"
    echo -n "$service"
}

create_net_dropin() {
    local dropin_folder
    dropin_folder=/mnt/etc/systemd/network/"$1".d
    mkdir -p "$dropin_folder"
    # sytemd-networkd requires these files to have 644 umask
    install -m 644 "$2" "$dropin_folder"/10-custom.conf
}

setup_network() {
    local eth_serv wifi_serv eth_custom wifi_custom
    declare -a ex
    eth_custom="$(mktemp)"
    wifi_custom="$(mktemp)"

    ask_y_n "Would you like to configure wired network access?" && eth_serv="$(create_netservice ethernet "$eth_custom")"
    if achroot pacman -Q iwd >/dev/null 2>&1; then
        wifi_serv="$(create_netservice wifi-station "$wifi_custom")"
        echo "IgnoreCarrierLoss=3s" >> "$wifi_custom"
    fi

    test -z "$eth_serv$wifi_serv" && return

    if [ -n "$eth_serv" ] && [ -n "$wifi_serv" ]; then
        for c in "$eth_custom" "$wifi_custom"; do
            echo -e "\n[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100 " >> "$c"
        done
    fi

    msg "
There are a couple of improvements over the basic systemd provided network files
that can be set up in addition. These include:
    - Multicast/MulticastDNS support
    - making systemd wait for a routable IP address
    - creating a smoother transition from wifi to ethernet connections (if both are available)"
    if ask_y_n "Would you like to add these to the existing network configurations?"; then
        msg "Creating custom drop-in file(s)..."
        test -n "$eth_serv" && create_net_dropin "$eth_serv" "$eth_custom"
        test -n "$wifi_serv" && create_net_dropin "$wifi_serv" "$wifi_custom"
    fi

    if achroot pacman -Q dnscrypt-proxy >/dev/null 2>&1; then
        msg "Setting up dnscrypt-proxy for local DNS resolving..."
        sed -ri 's/^listen_addresses.+$/listen_addresses = ['\''127.0.0.1:53'\'', '\''[::1]:53'\'']/' /mnt/etc/dnscrypt-proxy/dnscrypt-proxy.toml
        echo "nameserver ::1
nameserver 127.0.0.1
options edns0" >> /mnt/etc/resolv.conf
        achroot systemctl enable dnscrypt-proxy.service || exit 1
    fi

    msg "
Enabling systemd network services..."
    achroot systemctl enable systemd-networkd.service || exit 1
    if [ -n "$wifi_serv" ]; then
        achroot systemctl enable iwd.service || exit 1
    fi
}

calculate_swap_rec_zram() {
    local ram_mb
    ram_mb="$(awk_calc "$1 / 1024")"
    if ((0<=ram_mb && ram_mb<=2048)); then
        echo -n 3
    elif ((2049<=ram_mb && ram_mb<=4096)); then
        echo -n 2
    elif ((4097<=ram_mb && ram_mb<=16384)); then
        echo -n 1
    else
        echo -n 0
    fi
}

calculate_swap_rec_no_zram() {
    local ram_mb swap_mb
    ram_mb="$(awk_calc "$1 / 1024")"

    if ((0<=ram_mb && ram_mb<=2048)); then
        swap_mb=$((ram_mb * 2))
    elif ((2049<=ram_mb && ram_mb<=4096)); then
        swap_mb=$(awk_calc "ram_mb * 1.5")
    elif ((4097<=ram_mb && ram_mb<=8192)); then
        swap_mb=$ram_mb
    elif ((8193<=ram_mb && ram_mb<=16384)); then
        swap_mb=$(awk_calc "ram_mb / 2")
    elif ((16385<=ram_mb && ram_mb<=32768)); then
        swap_mb=8192
    else
        swap_mb=4096
    fi
    awk_calc "$swap_mb / 1024"
}

create_swap() {
    local swapfile
    swapfile=/mnt/swap/swapfile
    msg "Creating swap file..."
    if ! test -f "$swapfile"; then
        mkswap -U clear --size "$1" --file "$swapfile" || exit 1
    fi

    msg "Mounting swap file..."
    swapon "$swapfile" || exit 1
}

create_zram() {
    local zram_conf zram_dev
    zram_conf=/mnt/etc/systemd/zram-generator.conf

    msg -e "\nGenerating zram-generator config file..."
    echo "[zram0]
zram-size = min(ram / 2, 4096)
compression-algorithm = zstd" > "$zram_conf"
    msg "A configuration file for one zram device has been written to
zram-generator.conf. Have a look at the config file. In most cases, no further
customization should be necessary; zram-size is set to its default value and
zstd will be used for compression."
    pause
    edit_file "$zram_conf"

    # in case the user has added additional zram devices
    while read -r line; do
        zram_dev="${line:1:-1}"
        msg "Enabling systemd service for $zram_dev"
        achroot systemctl enable systemd-zram-setup@"$zram_dev".service
    done < <(grep -E '^\[.+?\]$' "$zram_conf")
}

create_swap_zram() {
    local hib zram ram_kb ram_gb rec
    ram_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
    ram_gb="$(awk_calc "$ram_kb / 1024 / 1024")"
    ask_y_n "Will you use hibernation on the system?" && hib=yes
    achroot pacman -Q zram-generator >/dev/null 2>&1 && zram=yes

    if [ -n "$zram" ]; then
        rec="$(calculate_swap_rec_zram "$ram_kb")"
    else
        rec="$(calculate_swap_rec_no_zram "$ram_kb")"
    fi

    if [ -n "$hib" ] && [ "$rec" -lt $(("$ram_gb" + 2)) ]; then
        rec=$(("$ram_gb" + 2))
    fi


    msg -e "Your system has \033[1m${ram_gb}GB\033[0m of RAM."
    msg -n "The recommended swap size is: "
    if [ "$rec" = 0 ]; then
        msg "None."
        msg "Your system should run fine depending only on RAM and zram."
    else
        rec+="G"
        msg_bold "${rec}B"
    fi

    if ! ask_y_n "Would you like to continue with the recommendation?"; then
        read -rp "  Please give a swap size parseable by mkswap (e.g. ending in M or G): " rec
    fi

    test "$rec" = 0 && return

    create_swap "$rec"
    test -n "$zram" && create_zram
}

prepare_system() {
    test_system_mounted || exit 1

    msg "First, let's setup swap and zram. On modern systems with RAM sizes of 16GB and
more, the system can run without any issues using only zram and no swap space at
all. Swap can still be used as a safety net or if you have a specific RAM-heavy
use case in mind. Furthermore, if you want to use hibernation on your system,
swap space at least the size of the available RAM must be set up.

If you decide to use swap, a swap file will be used. Unlike a swap partition, a
swap file's size can be adapted much easier later if desired."
    ask_y_n "Would you like to continue?" continue skip && create_swap_zram

    msg "With all partitions mounted and a swap file created, we can generate the file
system table."
    if ask_y_n "Would you like to continue?" continue skip; then
        genfstab -U /mnt >> /mnt/etc/fstab || exit 1
        msg "The fstab file was successfully created. However, it is recommended to check it
manually for errors.
For this, we will open it using \$EDITOR."
        pause
        edit_file /mnt/etc/fstab
    fi

    msg "
On to time settings. Please note that your system's hardware clock needs to be
set to UTC for this to work correctly."
    ask_y_n "Would you like to continue?" continue skip && set_time

    msg "
Now, locale settings."
    ask_y_n "Would you like to continue?" continue skip && set_locales

    msg "
If you are using a keyboard layout other than the default US one, you can set
it as default for the virtual console. This will most likely not affect the
keyboard settings in a desktop environment."
    ask_y_n "Would you like to specify a custom keyboard layout?" && set_vcons_kl

    msg "
Select a hostname next. In line with RFC 1178, a hostname should only include
lowercase letters, digits and dashes (but not at the beginning)."
    ask_y_n "Would you like to continue?" continue skip && set_hostname

    msg "
For network access on the new system, we will use systemd-networkd for wired and
iwd for wireless access."
    ask_y_n "Would you like to continue?" continue skip && setup_network

    msg "
Finally, we will run passwd on the new system to set its root password."
    ask_y_n "Would you like to continue?" continue skip && achroot passwd
}

adapt_hooks() {
    local hooks sdv_hook
    hooks="$(grep '^HOOKS' "$1")"

    ask_y_n "Will you be using a non-standard keymap or console font?" && sdv_hook="sd-vconsole"

    if achroot pacman -Qqs -- '-ucode$' >/dev/null 2>&1; then
        grep -q microcode <<< "$hooks" || hooks="${hooks/autodetect/autodetect microcode}"
    fi

    # remove udev as it is supplanted by systemd hook
    grep -q udev <<< "$hooks" && hooks="${hooks/udev /}"
    grep -q systemd <<< "$hooks" || hooks="${hooks/autodetect/systemd autodetect}"
    grep -q keyboard <<< "$hooks" || hooks="${hooks/block/keyboard block}"
    # TODO: remove hooks supplanted by sd-vconsole
    test -n "$sdv_hook" && grep -q "$sdv_hook" <<< "$hooks" || hooks="${hooks/block/$sdv_hook block}"
    grep -q sd-encrypt <<< "$hooks" || hooks="${hooks/filesystems/sd-encrypt filesystems}"

    sed -i 's/^HOOKS=.*/'"$hooks"'/' "$1" || exit 1
}

generate_kcmdline() {
    local gpt_automount efi root cmdline
    get_config_var EFI_PARTITION
    efi="${config_vars[EFI_PARTITION]}"
    get_config_var ROOT_PARTITION
    root="${config_vars[ROOT_PARTITION]}"
    get_config_var ROOT_ENCRYPTED_NAME
    cryptroot="${config_vars[ROOT_ENCRYPTED_NAME]}"

    msg "
Next, we will generate the kernel command line, which will be integrated into
the UKI."

    if [ "$(get_part_parent "$efi")" = "$(get_part_parent "$root")" ]; then
        msg "
systemd supports automounting the root partition (other partitions as well but
for those we are using subvolumes), which makes things easier to maintain in the
long run.
The encrypted partition will be provided as /dev/gpt-auto-root-luks, the
unlocked root partition as /dev/gpt-auto-root.
These are the requirements for automounting support:
    - using a systemd initramfs
    - the root and EFI system partitions must be on the same device
    - the correct GPT partition types must be set
    - the bootloader must support it

By following this script, all the criteria should have been met. Nevertheless,
you can still choose to specify the root partition explicitly."
        if ask_y_n "Would you like to use GPT automounting?"; then
            gpt_automount=1
        else
            gpt_automount=0
        fi
        config_vars[GPT_AUTOMOUNT]=$gpt_automount
    fi
   
    msg "Before looking at the generated file, here's an overview of the kernel
options included:"
    test $gpt_automount = 0 && msg "    - root: the root partition (i.e. the mapping of the unlocked cryptdevice)"
    msg "    - rootflags: options for mounting the root partitions - for our setup, this
                 is important as this is where we specify the root subvolume
    - rw: read/write access (this is required for the root partition)
    - quiet: suppress output when booting
    - bgrt_disable: suppress display of the OEM logo"
    pause
    cmdline="rootflags=subvol=@ rw quiet bgrt_disable"
    test $gpt_automount = 0 && cmdline="root=/dev/mapper/$cryptroot $cmdline"
    echo "$cmdline" > /mnt/etc/kernel/cmdline
    edit_file /mnt/etc/kernel/cmdline
}

create_crypttab_initramfs() {
    local gpt_automount root root_entry
    get_config_var GPT_AUTOMOUNT
    gpt_automount="${config_vars[GPT_AUTOMOUNT]}"
    get_config_var ROOT_PARTITION
    root="${config_vars[ROOT_PARTITION]}"

    msg "
The last step for creating a UKI is setting up crypttab.initramfs. This is a
crypttab file that will be added to the image and will be used at boot time to
unlock any encrypted devices listed in it."

    if [ "$gpt_automount" = 1 ]; then
        msg "As you have set up automounting, you can entirely ignore this file. However, if
you have set up additional unlock methods for your encrypted partitions,
crypttab.initramfs is a good place to specify them (the other place would be the
kernel commandline). We will come back to enrolling other keys and adding them
to crypttab.initramfs once we have booted into the new system."
        ask_y_n "Nevertheless, would you like to edit crypttab.initramfs now?" || return
    else
        pause
    fi

    if [ "$gpt_automount" = 1 ]; then
        root_entry="  cryptroot    /dev/gpt-auto-root-luks    none"
    else
        root_entry="  cryptroot    UUID=$(lsblk -ndo UUID "$root")    none"
    fi

    echo "$root_entry" >> /mnt/etc/crypttab.initramfs
    edit_file /mnt/etc/crypttab.initramfs
    # option for crypttab.initramfs (fido2)
}

setup_mkinitcpio() {
    local BINARIES mkcp_conf hooks uki_folder
    mkcp_conf="$(mktemp)"
    
    msg "
Let's get started! First, we will add additional hooks to the mkinitcpio config.
These are required for unlocking the root partition at boot time. If you are
using a non-US console keymap or a non-default console font (you aren't if you
have only been following this script so far), we also need to add the
sd-vconsole hook.

Additionally, we will be adding the btrfs binary to the initial ramdisk so we
have access to it in emergency mode."
    cp /mnt/etc/mkinitcpio.conf "$mkcp_conf"

    source <(grep "^BINARIES" "$mkcp_conf")
    BINARIES+=("btrfs")
    sed -i 's/^BINARIES=.*/BINARIES=('"${BINARIES[*]}"')/' "$mkcp_conf" || exit 1

    adapt_hooks "$mkcp_conf"

    msg "
Let's have a look at the edited mkinitcpio.conf. Check it for errors and make
additional edits if desired."
    pause
    edit_file "$mkcp_conf"
    cp "$mkcp_conf" /mnt/etc/mkinitcpio.conf

    msg "
Now, we will edit the mkinitcpio preset file(s). Not much custom input should be
required here. You can comment out the default_options line if you would like to
suppress the splash boot image.

Be aware that you do not have to save generated UKIs at the path defined in the
preset config but it is recommended to do so. The bootloader (systemd-boot) will
only create entries automatically for images located at EFI/Linux on your EFI
system partition. If you put them in a different location, you will have to
create the corresponding entries manually."

    for p in /mnt/etc/mkinitcpio.d/*.preset; do
        msg "
Editing $p..."
        pause
        for i in default_uki fallback_uki default_options; do
            sed -ri 's/^#('"${i}"'=)/\1/' "$p" || exit 1
            sed -ri 's/("\/)efi/\1boot/' "$p" || exit 1
        done
        edit_file "$p"
    done

    generate_kcmdline

    create_crypttab_initramfs

    msg "
Now let's create our unified kernel image(s)."
    for p in /mnt/etc/mkinitcpio.d/*.preset; do
        uki_folder="$(grep '^default_uki=' "$p" | cut -d= -f2 | tr -d '"')"
        if [ -z "$uki_folder" ]; then
            msg "Error! No definition for \"default_uki\" found in $p."
            exit 1
        fi
        mkdir -p "/mnt/$(dirname "$uki_folder")" || exit 1
        achroot mkinitcpio -p "$(basename -s ".preset" "$p")"
    done
}

write_loader() {
    local preset base default_uki fallback_uki
    preset="$1"
    base="$2"
    name="$(basename -s .preset "$1")"
    name="${name^^}"
    for i in default_uki fallback_uki; do
        source <(grep "^${i}" "$preset")
    done
    echo "title        Arch${name}
linux        "
}

install_bootloader() {
    local default loader_conf
    loader_conf=/mnt/boot/loader/loader.conf

    msg "Running \"bootctl install\"..."
    achroot bootctl install || exit 1
    msg "Enabling automatic bootloader updates..."
    achroot systemctl enable systemd-boot-update.service || exit 1

    msg "Writing bootloader config..."

    for e in /mnt/boot/EFI/Linux/*.efi; do
        echo -n "$e" | grep -q "fallback" && continue
        default="$(basename "$e")" && break
    done

    echo "default */$default
timeout menu-hidden
editor false
console-mode max" > "$loader_conf"

    msg "\nThe bootloader was installed succesfully. systemd-boot will automatically
generate entries for Windows, macOS (I hope that's the right name) and all .efi
files in /boot/EFI/Linux. You can customize the bootloader config further, if
you would like. Here's an overview of the settings included right now:
    - default: the default entry to boot; set to a value determined by the
               script or to nothing if it was unsuccesful in finding an entry
    - timeout: how long to show the boot menu; set to menu-hidden, which will
               not display the menu unless the spacebar is held down at boot
    - editor: whether or not to allow editing the kernel commandline; disabled
              for security
    - console-mode: resolution of the boot menu; set to max, the highest
                    possible resolution

If you put UKIs in a folder other than /boot/EFI/Linux, or have other EFI
applications you would like to include in the boot menu, remember to create
entries for them manually."
    pause
    edit_file "$loader_conf"
}

make_bootable() {
    test_system_mounted || exit 1

    msg "First, we will create one or more unified kernel image(s) (UKI). This requires
adapting the configuration and preset files for mkinitcpio and customizing the
kernel command line. This script should take care of most of the work but each
config file will be opened with a text editor (\$EDITOR) so you can make custom
adjustments.
One thing to note is that we will be using a systemd based initramfs. ArchLinux
by default uses busybox but using systemd gives us access to a couple of handy
extensions during the boot process."

    setup_mkinitcpio

    msg "
Now, let's install the bootloader."
    install_bootloader
}
