# -*-bash-ts-*-
# shellcheck source=SCRIPTDIR/syl.sh

declare -A PART_TYPES GDISK_PART_TYPES
PART_TYPES[root]="4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
GDISK_PART_TYPES[root]="8304"
PART_TYPES[home]="933ac7e1-2eb4-4f13-b844-0e14e2aef915"
GDISK_PART_TYPES[home]="8302"
PART_TYPES[efi]="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
GDISK_PART_TYPES[efi]="ef00"
PART_TYPES[xbootldr]="bc13c2ff-59e6-4262-a352-b275fd6f7172"
GDISK_PART_TYPES[xbootldr]="ea00"

create_parts() {
    local disk part
    disk="$1"
    msg "Before we start, let's have a look at the current partition table:
"
    sgdisk -p "$disk" || exit 1
    msg_bold "
The total size of this disk is roughly $(($(blockdev --getsize64 "$disk") /
1000000)) Megabytes.
The total size of the largest continuous block of empty space is roughly
$(get_largest_empty_blk_in_m "$disk") Megabytes."
    pause

    explain create_parts && pause

    check_for_p "$disk" efi || create_efi_p "$disk"

    check_for_p "$disk" xbootldr || maybe_create_xbootldr_p "$disk"

    check_for_p "$disk" root || create_p "$disk" "root" "50G" "2G" "${GDISK_PART_TYPES[root]}"
}

check_for_p() {
    local disk name
    disk="$1"
    name="$2"
    part="$(get_p_by_type "$disk" "${PART_TYPES[${name}]}")"
    test ! "$name" = "root" && name="${name^^}"
    if [ -n "$part" ]; then
        msg_bold "
${name} partition found on ${disk}, skipping creation..."
        return 0
    else
        return 1
    fi
}

create_efi_p() {
    create_p "$1" "EFI" "1G" "500M" "${GDISK_PART_TYPES[efi]}"
    get_config_var EFI_PARTITION
    prexec mkfs.fat -F 32 "${config_vars[EFI_PARTITION]}" >/dev/null || exit 1
    msg "EFI system partition formatted."
}

maybe_create_xbootldr_p() {
        explain xbootldr
        if ask_y_n "Would you like to create an XBOOTLDR partition?"; then
            create_p "$1" "XBOOTLDR" "2G" "500M" "${GDISK_PART_TYPES[xbootldr]}"
            get_config_var XBOOTLDR_PARTITION
            prexec mkfs.fat -F 32 "${config_vars[XBOOTLDR_PARTITION]}" >/dev/null || exit 1
            msg "XBOOTLDR system partition formatted."
        fi
}

get_p_parent() {
    lsblk -rnpo PKNAME "$1" | head -n1
}

setup_parts() {
    local choice disk_head
    declare -a disks 

    while read -r line; do disks+=("$line"); done < <(lsblk -dno PATH,TYPE | awk '{if ($2 == "disk") print $1}')

    case ${#disks[@]} in
        1)
            choice="${disks[0]}"
            msg "Continuing with ${choice} as it is the only writable disk available..."
            pause
            ;;
        0)
            msg "No writable disks found. Unable to continue."
            exit 1
            ;;
        *)
            msg "On which disk would you like to install Arch Linux?"
            tab_display "${disks[@]}"
            choice="$(select_item "${disks[@]}")"
            ;;
    esac
    config_vars[INSTALL_DISK]="$choice"

    disk_head="$(udevadm info --query=property "$choice"| awk -F= '{if ($1=="ID_PART_TABLE_TYPE") {print $2}}')" || exit 1
    msg -n "Is there an existing GUID partition table on $choice? "

    case "$disk_head" in
        gpt)
            msg_bold "Yes."
        ;;
        mbr)
            msg_bold "No, pure MBR found."
            msg "MBR is not supported. Exiting..."
            exit 1
        ;;
        "")
            msg_bold "No."
            if ask_y_n "Would you like to create one?"; then
                if ! prexec parted "$choice" mklabel gpt >/dev/null 2>&1; then
                    msg "There was an error creating the GPT."
                    exit 1
                else
                    msg "Created GPT on $choice."
                fi
            else
                msg "Can't continue without GPT written to disk."
                exit 1
            fi
        ;;
    esac

    if [ -n "$(findmnt -Q 'SOURCE =~ "'"${choice}"'.+"')" ]; then
        msg "Partitions on $choice are currently mounted. Unmount them before proceeding."
        exit 1
    fi

    create_parts "$choice"
}

encrypt_parts() {
    # very simple at this point but maybe in the future other partition schemes
    # will be supported
    explain_and_confirm encrypt_parts
    get_config_var ROOT_PARTITION
    encrypt_p "${config_vars[ROOT_PARTITION]}" cryptroot
    config_vars[ROOT_ENCRYPTED_NAME]="cryptroot"
}

encrypt_p() {
    set +x  # Disable shell tracing so password values don't get leaked
    local part crypt_part pw pw_bckp
    part="$1"
    crypt_part="$2"

    while true; do
        read -rsp "  Please give an encryption password for $part: " pw
        echo ""
        read -rsp "  Please repeat the password for $part: " pw_bckp
        echo ""
        test "$pw" = "$pw_bckp" && break
        msg "Passwords do not match. Please try again."
    done

    msg "Encrypting partition at $part.
THIS WILL IRREVOCABLY DESTROY ALL DATA ON $part."
    ask_y_n_secure "Are you sure you want to continue?" || exit 1

    (printf "%s" "$pw" | prexec cryptsetup luksFormat --key-file - "$part") || exit 1
    msg "Mapping unlocked partition $part to $crypt_part..."
    (printf "%s" "$pw" | prexec cryptsetup open --key-file - "$part" "$crypt_part") || exit 1
}

get_lowest_part_num() {
    for p in $(seq 1 128); do
        if [ ! -b "${1}$p" ]; then
            echo -n "$p"
            return
        fi
    done
    msg "The maximum number of 128 partitions on $1 has already been reached. Oof."
    exit 1
}

parse_p_size() {
    local size unit disk
    disk="$1"

    if [[ "$2" == "0" ]]; then
        get_largest_empty_blk "$disk"
        return
    fi

    unit="$(echo -n "${2: -1}" | tr "[:lower:]" "[:upper:]")"
    size="${2:0:$((${#2} - 1))}"
    case "$unit" in
        G)
            echo -n "$(("$size" * 1000000000 / 512))"
            return
            ;;
        M)
            echo -n "$(("$size" * 1000000 / 512))"
            return
            ;;
        %)
            local leb product
            leb=$(get_largest_empty_blk "$disk") || exit 1
            product=$(awk_calc "$leb * ($size / 100)")
            msg "This is equal to $(("$product" * 512 / 1000000)) Megabytes."
            if ask_y_n "Would you like to continue?"; then
                echo -n "$product"
                return
            else
                return 1
            fi
            ;;
        [0-9])
            if [[ "$2" =~ ^[0-9]+ ]]; then
                echo -n "$2"
                return
            fi
            ;&
        *)
            msg "Couldn't parse size '$2'."
            return 1
            ;;
    esac
}

get_p() {
    local part disk
    disk="$1"
    part="$(get_p_by_type "$disk" "${PART_TYPES[$2]}")"
    echo -n "$part"
}

get_p_by_type() {
    local disk type part
    disk="$1"
    type="$2"
    while read -r line; do
        if [ "$(echo "${line@L}" | cut -d" " -f2)" = "$type" ]; then
            part="$(echo -n "$line" | cut -d" " -f1)"
            break
        fi
    done < <(lsblk -prno PATH,PARTTYPE "$disk")
    echo -n "$part"
}

get_diff_p() {
    declare -a before after
    while (( $# )); do
        test -z "$1" && { shift; break; }
        before+=("$1")
        shift
    done
    after=("$@")

    for p in "${after[@]}"; do
        if ! printf '%s\n' "${before[@]}" | grep -Fxq -- "$p"; then
            echo -n "$p"
            break
        fi
    done
}

prompt_p_size() {
    local disk type default min_secs val secs
    disk=$1
    type=$2
    default=$3
    min=$4
    min_secs="$(parse_p_size "${config_vars[INSTALL_DISK]}" "$min")"

    msg "Please provide the desired size for the '$type' partition.
It should be at least $min."
    read -rp "  Set size of partition '$type' to (default: $default): " val
    test -z "$val" && val="$default"
    secs="$(parse_p_size "${config_vars[INSTALL_DISK]}" "$val")"
    test ! $? -eq 0 && return 1
    if [ "$secs" -lt "$min_secs" ]; then
        msg_bold "This is below the recommended size of $min for this type of partition!"
        msg "This is likely to cause issues in the following steps and could result in the
installation failing."
        ask_y_n "Are you sure you want to continue?" || return 1
    fi

    if [ "$(get_largest_empty_blk "$disk")" -ge "$secs" ]; then
        echo -n "$secs"
    else
        msg "Disk $disk does not have enough empty space to accomodate a partition of size $val."
        return 1
    fi
}

create_p() {
    local disk type default min secs part start_sec end_sec part
    declare -a guid
    disk=$1
    type=$2
    default=$3
    min=$4
    test -n "$5" && guid=("-t" "0:$5")

    get_config_var INSTALL_DISK
    while true; do
        secs="$(prompt_p_size "$disk" "$type" "$default" "$min")" && break
    done

    while read -r line; do before+=("$line"); done < <(lsblk -prno NAME "$disk")

    start_sec="$(sgdisk -F "$disk")" || exit 1
    end_sec=$(("$start_sec" + "$secs"))
    prexec sgdisk -n 0:"$start_sec":"$end_sec" "$disk" "${guid[@]}" || exit 1
    echo "$type partition created."

    while read -r line; do after+=("$line"); done < <(lsblk -prno NAME "$disk")

    # remember that an empty string must be passed between before and after!
    part="$(get_diff_p "${before[@]}" "" "${after[@]}")"
    test_p "$part" || exit 1
    config_vars["${type@U}_PARTITION"]="$part"
}

test_p() {
    if [ ! -b "$1" ]; then
        msg "No block device at $1. Something went very wrong."
        return 1
    else
        return 0
    fi
}

get_largest_empty_blk() {
    local start end
    start=$(sgdisk -F "$1") || exit 1
    end=$(sgdisk -E "$1") || exit 1
    echo -n "$(("$end" - "$start"))"
}

get_largest_empty_blk_in_m() {
    echo -n "$(($(get_largest_empty_blk "$1") * 512 / 1000000))"
}
