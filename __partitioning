# -*-bash-ts-*-
create_parts() {
    local disk
    disk="$1"
    msg "
Before we start, let's have a look at the current partition table:
"
    sgdisk -p "$disk" || exit 1
    msg "
Partitions created by this script will always use the largest continuous block
of empty space available.
If the partition table is heavily fragmented, you should repartition it
manually."
    msg_bold "The total size of this disk is roughly $(($(blockdev --getsize64 "$disk") /
1000000)) Megabyte.
The total size of the largest continuous block of empty space is roughly
$(get_largest_empty_blk_in_m "$disk") Megabyte."
    msg "
When providing partition sizes, you can either give values ending in G(igabyte),
M(egabyte) or %(=percentage of total disk space.)
Without any of these qualifiers at the end, values will be considered sectors of
512-byte size.
The value 0 means the largest continuously empty block on the disk (most of the
time, this is equivalent to the remaining empty space).

Now let's get started."

    if [ -z "$(get_part_by_type "$disk" "c12a7328-f81f-11d2-ba4b-00a0c93ec93b")" ]; then
        create_part "$disk" "EFI" "1G" "EF00"
        get_config_var EFI_PARTITION
        mkfs.fat -F 32 "${config_vars[EFI_PARTITION]}" >/dev/null || exit 1
        msg "EFI system partition formatted."
    fi

    create_part "$disk" "root" "0" "8304"

    # TODO: XBOOTLDR support
}

get_part_parent() {
    lsblk -rnpo PKNAME "$1" | head -n1
}

setup_parts() {
    local disk disk_head
    while true; do
        read -rp "  Please provide a path to the disk you would like to use: " disk
        if [ ! -b "$disk" ]; then
            msg "$disk is not a block device"
        elif [ ! "$(dirname "$disk")" = "/dev" ]; then
            msg "Disk path needs to reside in /dev."
        else
            break
        fi
    done

    config_vars[INSTALL_DISK]="$disk"
    disk_head="$(udevadm info --query=property "$disk"| awk -F= '{if ($1=="ID_PART_TABLE_TYPE") {print $2}}')" || exit 1
    msg -n "Is there an existing GUID partition table on $disk? "
    case "$disk_head" in
        gpt)
            msg_bold "Yes."
        ;;
        mbr)
            msg_bold "No, pure MBR found."
            msg "MBR is not supported. Exiting..."
            exit 1
        ;;
        "")
            msg_bold "No."
            if ask_y_n "Would you like to create one?"; then
                parted "$disk" mklabel gpt >/dev/null 2>&1
                if [ $? -gt 0 ]; then
                    msg "There was an error creating the GPT."
                    exit 1
                else
                    msg "Created GPT on $disk."
                fi
            else
                msg "Can't continue without GPT written to disk."
                exit 1
            fi
        ;;
    esac

    if [ -n "$(findmnt -Q 'SOURCE =~ "'"${disk}"'[0-9]+"')" ]; then
        msg "
Partitions on $disk are currently mounted. Unmount them before proceeding."
        exit 1
    fi

    create_parts "$disk"
}

encrypt_parts() {
    # very simple at this point but maybe in the future other partition schemes
    # will be supported
    get_config_var ROOT_PARTITION
    encrypt_p "${config_vars[ROOT_PARTITION]}" cryptroot
    config_vars[ROOT_ENCRYPTED_NAME]="cryptroot"
}

encrypt_p() {
    set +x  # Disable shell tracing so password values don't get leaked
    local part crypt_part pw pw_bckp
    part="$1"
    crypt_part="$2"

    while true; do
        read -rsp "  Please give an encryption password for $part: " pw
        msg ""
        read -rsp "  Please repeat the password for $part: " pw_bckp
        msg ""
        test "$pw" = "$pw_bckp" && break
        msg "Passwords do not match. Please try again."
    done

    msg "
Encrypting partition at $part. THIS WILL IRREVOCABLY DESTROY ALL DATA ON $part."
    ask_y_n_secure "Are you sure you want to continue?" || exit 1

    (printf "%s" "$pw" | cryptsetup luksFormat --key-file - "$part") || exit 1
    msg "Mapping unlocked partition $part to $crypt_part..."
    (printf "%s" "$pw" | cryptsetup open --key-file - "$part" "$crypt_part") || exit 1
}

get_lowest_part_num() {
    for p in $(seq 1 128); do
        if [ ! -b "${1}$p" ]; then
            echo -n "$p"
            return
        fi
    done
    msg "The maximum number of 128 partitions on $1 has already been reached. Oof."
    exit 1
}

parse_part_size() {
    local size unit disk
    disk="$1"

    if [[ "$2" == "0" ]]; then
        get_largest_empty_blk "$disk"
        return
    fi

    unit="$(echo -n "${2: -1}" | tr "[:lower:]" "[:upper:]")"
    size="${2:0:$((${#2} - 1))}"
    case "$unit" in
        G)
            echo -n "$(("$size" * 1000000000 / 512))"
            return
            ;;
        M)
            echo -n "$(("$size" * 1000000 / 512))"
            return
            ;;
        %)
            local leb product
            leb=$(get_largest_empty_blk "$disk") || exit 1
            product=$(awk_calc "$leb * ($size / 100)")
            msg "This is equal to $(("$product" * 512 / 1000000)) Megabyte."
            if ask_y_n "Would you like to continue?"; then
                echo -n "$product"
                return
            else
                return 1
            fi
            ;;
        [0-9])
            if [[ "$2" =~ ^[0-9]+ ]]; then
                echo -n "$2"
                return
            fi
            ;&
        *)
            msg "Couldn't parse size '$2'."
            return 1
            ;;
    esac
}

get_part() {
    local part type disk
    disk="$1"

    case "$2" in
        "EFI")
            type="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"
            ;;
        "root")
            type="4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
            ;;
    esac

    part="$(get_part_by_type "$disk" "$type")"
    test -z "$part" && msg "No $1 partition found. Unable to continue."
    echo -n "$part"
}

get_part_by_type() {
    local disk type part
    disk="$1"
    type="$2"
    while read -r line; do
        if [ "$(echo "$line" | cut -d" " -f2 | tr "[:upper:]" "[:lower:]")" = "$type" ]; then
            part="$(echo -n "$line" | cut -d" " -f1)"
            break
        fi
    done < <(lsblk -prno PATH,PARTTYPE "$disk")
    echo -n "$part"
}

create_part() {
    local disk type default size part part_num start_sec end_sec
    disk=$1
    type=$2
    default=$3

    declare -a guid

    get_config_var INSTALL_DISK
    while true; do
        read -rp "  Please provide the desired size of partition '$type' (default: $default): " val
        test -z "$val" && val="$default"
        size="$(parse_part_size "${config_vars[INSTALL_DISK]}" "$val")"
        test ! $? -eq 0 && continue
        if [ "$(get_largest_empty_blk "$disk")" -ge "$size" ]; then
            break
        else
            msg "Disk $disk does not have enough empty space to accomodate a partition of size $val."
        fi
    done

    part_num="$(get_lowest_part_num "$disk")"
    start_sec="$(sgdisk -F "$disk")" || exit 1
    end_sec=$(("$start_sec" + "$size"))
    test -n "$4" && guid=("-t" "$part_num:$4")
    sgdisk -n "$part_num":"$start_sec":"$end_sec" "$disk" ${guid[*]} || exit 1
    echo "$type partition created."

    part="$disk$part_num"
    test_part "$part" || exit 1
    config_vars["$(echo -n "${type}_PARTITION" | tr "[:lower:]" "[:upper:]")"]="$part"
}

test_part() {
    if [ ! -b "$1" ]; then
        msg "Oh no, something wrent something no partition exists at $1."
        return 1
    else
        return 0
    fi
}
